# These are public client settings. Never put service-role, Stripe secret,
# RevenueCat server, webhook or signing keys in VITE_ variables.
VITE_MONETISATION_ENABLED=false
VITE_ACCOUNTS_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat Apple PUBLIC SDK key only; never a server key.
VITE_REVENUECAT_APPLE_PUBLIC_KEY=
