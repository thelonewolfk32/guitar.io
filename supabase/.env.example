# Supabase injects SUPABASE_URL and server credentials automatically.
# Do not include reserved SUPABASE_ variables in secrets set files.
MONETISATION_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
BILLING_RETURN_URL=https://your-domain.example/account
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SERVER_API_KEY=
ALLOW_TEST_BILLING=false
ALLOWED_ORIGINS=guitario://app,capacitor://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://YOUR-ADMIN.pages.dev
# Optional signed desktop update feed. No secrets are shipped in the app.
UPDATE_DESCRIPTOR=
UPDATE_SIGNING_PRIVATE_KEY=

BRAVE_SEARCH_API_KEY=
APPLE_MUSIC_DEVELOPER_TOKEN=

# Operations endpoint is independent of ordinary user/owner access tokens.
MAINTENANCE_SECRET=
# Apple revocation uses a short-lived server-signed client secret.
APPLE_NATIVE_CLIENT_ID=io.guitario.mobile
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
# Alert thresholds. Set actual account budgets before enabling the scheduler.
OPS_STORAGE_LIMIT_BYTES=1073741824
OPS_DOWNLOAD_LIMIT_BYTES=5368709120
OPS_FUNCTION_LIMIT=500000
OPS_COST_LIMIT_USD=50
OPS_BASE_COST_USD=0
OPS_STORAGE_GIB_USD=0
OPS_DOWNLOAD_GIB_USD=0
OPS_MILLION_FUNCTIONS_USD=0
