# Server/operations machine only. Never put these in VITE_ settings or source ZIPs.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct or session pooler, port 5432, TLS. Never transaction pooler (6543).
SUPABASE_DB_URL=
MAINTENANCE_SECRET=
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=guitario-private-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Explicit separate recovery target; never the live source project.
RESTORE_SUPABASE_URL=
RESTORE_SERVICE_ROLE_KEY=
RESTORE_DB_URL=
RESTORE_CONFIRM_PROJECT_REF=
RESTORE_OUTPUT_DIR=
